# Google Cloud: the project and the (public, read-only) bucket that holds the
# JSON data files, plus a service-account key with write access to that bucket.
GCP_PROJECT_ID = "your-gcp-project-id"
GCP_BUCKET_NAME = "your-gcs-bucket-name"
GOOGLE_APPLICATION_CREDENTIALS = "path/to/service-account.json"

# Google Health API OAuth is NOT set here. Put your OAuth client secret at
# secrets/client_secret_health.json; `python main.py --auth` opens a browser to
# authorize and writes secrets/token_health.json (reused and auto-refreshed
# after that).

# watchdog.py alerting: a Telegram bot that pings you when the published data
# goes stale. Create a bot with @BotFather to get the token, then message your
# bot once and read the chat id off
# https://api.telegram.org/bot<TOKEN>/getUpdates
# Leave both empty to have the watchdog only print to stdout.
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""
